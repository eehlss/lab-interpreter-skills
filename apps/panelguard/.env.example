# Nebius Token Factory API Key
NEBIUS_API_KEY=

# Tavily API Key (optional)
TAVILY_API_KEY=

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=panelguard
LANGSMITH_API_KEY=

# Model IDs (env-configurable)
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_MID=nvidia/Nemotron-3.5-Super-VL
MODEL_REASON=nvidia/Nemotron-3-Ultra-550b-a55b

# Rate limiting
LIVE_DAILY_CAP=40

# Server
PORT=8080
